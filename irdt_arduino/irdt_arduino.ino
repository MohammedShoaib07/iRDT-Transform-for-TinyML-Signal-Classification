// irdt_arduino.ino
// Arduino Nano 33 BLE — iRDT ECG Classifier
// Requires: Arduino_TensorFlowLite library (install via Library Manager)
// Board: Arduino Nano 33 BLE  (Tools > Board > Arduino Mbed OS Nano Boards)

#include <TinyMLShield.h>
#include <tensorflow/lite/micro/all_ops_resolver.h>
#include <tensorflow/lite/micro/micro_interpreter.h>
#include <tensorflow/lite/schema/schema_generated.h>
#include "irdt_model_data.h"   // generated by convert_to_header.py

// ── iRDT config (must match what was used in train_colab.ipynb) ──
#define M            8
#define W            64
#define SEG_LEN      640
#define N_DELAYS     5     // both best_chan and fixed_chan have 5 unique delays
#define N_FEATURES   180   // confirmed: (M*N_DELAYS*2 + N_DELAYS*2) * 2 = 90*2

// best_chan from ECG DE optimizer: (3,5,9,10,16)
const int DELAYS[N_DELAYS] = {3, 5, 9, 10, 16};
// fixed_chan from CFG['ECG']['fixed']: (1,2,4,8,16)
const int FIXED[N_DELAYS]  = {1, 2, 4,  8, 16};

// ── TFLite globals ──
constexpr int TENSOR_ARENA_SIZE = 30 * 1024;   // 30 KB — adjust if model is larger
alignas(16) static uint8_t tensor_arena[TENSOR_ARENA_SIZE];

static tflite::AllOpsResolver      resolver;
static const tflite::Model*        tf_model   = nullptr;
static tflite::MicroInterpreter*   interpreter = nullptr;
static TfLiteTensor*               input_tensor  = nullptr;
static TfLiteTensor*               output_tensor = nullptr;

// ── iRDT transform (pure integer, no multipliers) ──
// Fills out[0..M*n_delays-1] with iRDT features
void irdt_transform(const int32_t* signal, const int* delays, int n_delays,
                    float* out) {
    int limit  = W / 4;
    int windows = SEG_LEN / W;
    int spectrum[20][N_DELAYS] = {};   // max 20 windows

    for (int i = 0; i < windows; i++) {
        int base = i * W;
        for (int k = 0; k < n_delays; k++) {
            int d = delays[k];
            int32_t s = 0;
            for (int t = limit; t < W - limit; t++) {
                s += abs(signal[base+t-d] + signal[base+t+d] - 2*signal[base+t]);
            }
            spectrum[i][k] = s;
        }
    }

    int fer = (windows - 2) / M;
    int lin = 1;
    for (int k = 0; k < M; k++) {
        for (int col = 0; col < n_delays; col++) {
            int32_t s = 0;
            for (int i = lin; i < lin + fer; i++) s += spectrum[i][col];
            out[k * n_delays + col] = (float)(s / (2 * W));
        }
        lin += fer;
    }
}

// ── expand(): raw + ratio + mean + std  (mirrors Python expand()) ──
// in_feat: M*n_delays floats → out_feat: M*n_delays*2 + n_delays*2 floats
void expand(const float* in_feat, int n_delays, float* out_feat) {
    int raw_size = M * n_delays;

    // copy raw
    for (int i = 0; i < raw_size; i++) out_feat[i] = in_feat[i];

    // channel ratios per segment
    for (int seg = 0; seg < M; seg++) {
        float row_sum = 1.0f;
        for (int k = 0; k < n_delays; k++) row_sum += in_feat[seg*n_delays + k];
        for (int k = 0; k < n_delays; k++)
            out_feat[raw_size + seg*n_delays + k] = in_feat[seg*n_delays + k] / row_sum;
    }

    // mean over time
    for (int k = 0; k < n_delays; k++) {
        float s = 0;
        for (int seg = 0; seg < M; seg++) s += in_feat[seg*n_delays + k];
        out_feat[2*raw_size + k] = s / M;
    }

    // std over time
    for (int k = 0; k < n_delays; k++) {
        float mean = out_feat[2*raw_size + k];
        float var  = 0;
        for (int seg = 0; seg < M; seg++) {
            float d = in_feat[seg*n_delays + k] - mean;
            var += d * d;
        }
        out_feat[2*raw_size + n_delays + k] = sqrtf(var / M);
    }
}

// ── build full feature vector (mirrors Python irdt_stack()) ──
// returns pointer to static buffer of size N_FEATURES
float feature_buf[N_FEATURES];
float* build_features(const int32_t* signal) {
    static float raw_opt[M * N_DELAYS];
    static float raw_fix[M * N_DELAYS];
    static float exp_opt[M * N_DELAYS * 2 + N_DELAYS * 2];
    static float exp_fix[M * N_DELAYS * 2 + N_DELAYS * 2];

    irdt_transform(signal, DELAYS, N_DELAYS, raw_opt);
    irdt_transform(signal, FIXED,  N_DELAYS, raw_fix);
    expand(raw_opt, N_DELAYS, exp_opt);
    expand(raw_fix, N_DELAYS, exp_fix);

    int half = N_FEATURES / 2;
    for (int i = 0; i < half; i++) feature_buf[i]        = exp_opt[i];
    for (int i = 0; i < half; i++) feature_buf[half + i] = exp_fix[i];
    return feature_buf;
}

// ── quantize float feature → int8 (matches INT8 TFLite input) ──
void quantize_input(const float* feat, int8_t* dst, int n,
                    float scale, int zero_point) {
    for (int i = 0; i < n; i++) {
        int v = (int)roundf(feat[i] / scale) + zero_point;
        dst[i] = (int8_t)constrain(v, -128, 127);
    }
}

void setup() {
    Serial.begin(115200);
    while (!Serial);

    tf_model = tflite::GetModel(irdt_model_data);
    if (tf_model->version() != TFLITE_SCHEMA_VERSION) {
        Serial.println("[ERROR] TFLite schema version mismatch");
        while (1);
    }

    static tflite::MicroInterpreter static_interpreter(
        tf_model, resolver, tensor_arena, TENSOR_ARENA_SIZE);
    interpreter = &static_interpreter;

    if (interpreter->AllocateTensors() != kTfLiteOk) {
        Serial.println("[ERROR] AllocateTensors failed — increase TENSOR_ARENA_SIZE");
        while (1);
    }

    input_tensor  = interpreter->input(0);
    output_tensor = interpreter->output(0);

    Serial.println("iRDT ECG Classifier ready");
    Serial.print("Input size: ");  Serial.println(input_tensor->bytes);
    Serial.print("Output size: "); Serial.println(output_tensor->bytes);
}

void loop() {
    // ── REPLACE THIS with real ADC/sensor reading ──
    // For testing: generate a synthetic signal
    static int32_t signal[SEG_LEN];
    for (int i = 0; i < SEG_LEN; i++)
        signal[i] = (int32_t)(32767.0f * sinf(2.0f * 3.14159f * i / 64.0f) * 0.3f);

    unsigned long t0 = micros();

    // 1. Extract iRDT features
    float* feat = build_features(signal);

    unsigned long feat_us = micros() - t0;

    // 2. Quantize and copy to TFLite input tensor
    float   scale      = input_tensor->params.scale;
    int32_t zero_point = input_tensor->params.zero_point;
    quantize_input(feat, input_tensor->data.int8, N_FEATURES, scale, zero_point);

    // 3. Run inference
    unsigned long t1 = micros();
    if (interpreter->Invoke() != kTfLiteOk) {
        Serial.println("[ERROR] Inference failed");
        return;
    }
    unsigned long inf_us = micros() - t1;

    // 4. Read output (INT8 → probabilities)
    float out_scale = output_tensor->params.scale;
    int   out_zp    = output_tensor->params.zero_point;
    int   n_classes = output_tensor->dims->data[1];

    int   best_class = 0;
    float best_prob  = -1e9f;
    for (int i = 0; i < n_classes; i++) {
        float prob = (output_tensor->data.int8[i] - out_zp) * out_scale;
        if (prob > best_prob) { best_prob = prob; best_class = i; }
    }

    // 5. Print result
    Serial.print("Result: ");
    Serial.print(best_class == 0 ? "NORMAL" : "PVC DETECTED");
    Serial.print("  confidence: ");
    Serial.print(best_prob * 100.0f, 1);
    Serial.print("%  |  feat: ");
    Serial.print(feat_us);
    Serial.print(" us  |  infer: ");
    Serial.print(inf_us);
    Serial.println(" us");

    delay(1000);
}
